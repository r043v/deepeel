execute_process(COMMAND "${NATIVE}" OUTPUT_VARIABLE native RESULT_VARIABLE result TIMEOUT 10)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Native BIOS digest failed: ${result}")
endif()
execute_process(COMMAND "${TRACED}" OUTPUT_VARIABLE traced RESULT_VARIABLE result TIMEOUT 10)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Instrumented BIOS digest failed: ${result}")
endif()
if(NOT native STREQUAL traced)
  message(FATAL_ERROR "BIOS instrumentation changed CPU/RAM/VRAM/device state:\nNative:\n${native}\nTraced:\n${traced}")
endif()
message(STATUS "11 native/instrumented BIOS state checkpoints match")
