foreach(system sms gg)
  foreach(mapper auto sega codemasters korean150)
    execute_process(COMMAND "${CLI}" z80 explore ${system} "${ROM}" --mapper ${mapper}
      --max-total 24 --input-total 0 --fork-cap 0 --no-vector-seeds --no-closure
      RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE errors)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "${system}/${mapper}: ${status}: ${errors}")
    endif()
    if(mapper STREQUAL "auto")
      set(expected "Sega mapper: codemasters (auto)")
    else()
      set(expected "Sega mapper: ${mapper} (explicit)")
    endif()
    string(FIND "${report}" "${expected}" found)
    if(found LESS 0)
      message(FATAL_ERROR "missing '${expected}' in ${report}")
    endif()
  endforeach()
endforeach()
foreach(case "sms|plain" "gg|ascii8" "sg|sega" "sms|unknown" "msx|sega")
  string(REPLACE "|" ";" parts "${case}")
  list(GET parts 0 system)
  list(GET parts 1 mapper)
  execute_process(COMMAND "${CLI}" z80 explore ${system} "${ROM}" --mapper ${mapper}
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
  if(NOT status EQUAL 2)
    message(FATAL_ERROR "${system}/${mapper}: expected usage error 2, got ${status}")
  endif()
endforeach()
