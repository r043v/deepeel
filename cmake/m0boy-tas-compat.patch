+/* gbl.h (gbl_sync_pad_delay): GBHawk latches the movie's pad at its vblank
+ * edge, 79,505 cycles into the m0boy frame that carries it; a set before
+ * then stays pending (the previous buttons remain visible).  Resolved at
+ * instruction fetch, on P1 reads/writes and in gbl_set_buttons. */
+static uint8_t pad_pending, pad_queued;
+static uint32_t pad_at;
+
+void gbl_pad_pending_check(uint32_t now) {
+    if (pad_queued && (int32_t)(now - pad_at) >= 0) {
+        pad_queued = 0;
+        if (pad_pending & ~buttons) IF |= 0x10; /* GBHawk: IRQ at the latch edge */
+        buttons = pad_pending;
+        joypad_update();
+    }
