+/* ---- movie sync compatibility (C interpreter path only) -----------------
+ * A tool-assisted movie replays only on the timing its recording emulator
+ * had.  These knobs reproduce documented quirks of such an emulator; 0 (the
+ * default) is the hardware behaviour.  The host sets them per instance; they
+ * are configuration, not machine state (gbl_reset and gbl_state_io leave
+ * them alone).
+ *  - gbl_sync_div_skew: cycles added to the clock when DIV is read.  VBA-rr's
+ *    GB core (V8) charges an instruction's cycles before executing it, so its
+ *    register reads see the end of the instruction: 4 cycles after the
+ *    hardware's last M-cycle access.
+ *  - gbl_sync_vba_off_clock: the frame clock around LCD off/on.
+ *    1 = VBA-rr v24 (V8 core): virtual frames while the LCD is off keep the
+ *    line clock's phase; a frame ends at each LY 144->145 step once the
+ *    white screen is up ((150 - LY) lines + 49 M-cycles after the
+ *    switch-off), instead of every 70224 cycles from the switch-off.
+ *    2 = VBA 1.7.2 based cores (up to VBA-rr v23, V7 core): no frame at all
+ *    while the LCD is off (one every 600 frame lengths at most, so a host
+ *    frame hook still runs), and an enable keeps LY at 0 in mode 0 for ten
+ *    lines (VBA loads the mode-1 length) without the LYC=0 STAT edge.
+ *    Its cycle table also charges RES/SET b,(HL) 3 M-cycles instead of 4.
+ *    3 = BizHawk (Gambatte core, VBlankDrivenFrames): a host frame ends at
+ *    the video frame's completion or when its 35112-sample budget (one frame
+ *    length) runs out, whichever comes first.  With the LCD off no video
+ *    frame completes until about 1828 cycles (4 lines) after the switch-off, so
+ *    frames then end on the budget alone (an enable late in a frame ends it
+ *    on the budget too, before the first vblank of the new frame).
+ *    There is no vblank on hardware with the LCD off: these are frame-clock
+ *    conventions, the movie's.  Value 2 needs the C timing path (the ARM
+ *    assembly gbl_ppu_advance_off ignores the pending enable). */
+extern uint8_t gbl_sync_div_skew;
+extern uint8_t gbl_sync_vba_off_clock;
+/* GBHawk (BizHawk's own core) pad and divider schedule, for its .bk2 movies.
+ *  - gbl_sync_pad_delay: cycles between the host's gbl_set_buttons (at the
+ *    frame boundary) and the pad becoming readable.  GBHawk advances one
+ *    fixed 70224-cycle frame per movie frame but only latches the movie's
+ *    pad at the vblank edge inside it (LY hitting 144, cycle 65664), and its
+ *    its boot reaches $0100 14,481 cycles before the 334 dropped movie
+ *    frames end, so the pad the movie latched for frame f must become
+ *    readable 14,481 cycles later than deepeel's vblank-edge set (deepeel
+ *    drops the 334 boot frames and sets the delay).  0 = readable at once (hardware behaviour).
+ *    While a delayed set is pending, the previous buttons stay visible.
+ *  - gbl_sync_div_extra: cycles added to the clock when DIV is read, on top
+ *    of gbl_sync_div_skew.  GBHawk's divider starts at 0xFFFE and counts
+ *    from power-on, so at the movie's $0100 (23,440,335 cycles) the low 16
+ *    bits of the phase are 0xFE4D (uint8_t gbl_sync_div_skew cannot hold
+ *    it).
+ *  - gbl_sync_ppu_phase: cycles of line 153 already elapsed at the movie's
+ *    $0100.  GBHawk's line 153 zeroes LY at cycle 6 and skips the next
+ *    boundary, so its 0->1 flip lands 912 cycles after the 153 boundary
+ *    (measured on SML2: flips at $0100-405 and $0100+507).  m0boy's reset
+ *    starts its line at $0100 instead; the host calls gbl_ppu_phase_apply
+ *    right after the movie machine's state is loaded to move the line start
+ *    back by this much and put LY in the zeroed 153 state, making every LY
+ *    read land on the same value (SML2's LY==0x94 poll loops read
+ *    identical values at identical cycles).  0 = phase 0 (hardware reset
+ *    behaviour). */
+void gbl_pad_pending_check(uint32_t now); /* gbl_core.c, GBHawk pad latch */
+void gbl_ppu_phase_apply(void); /* gbl_ppu.c, GBHawk line-153 phase */
+extern uint32_t gbl_sync_pad_delay;
+extern uint16_t gbl_sync_div_extra;
+extern uint16_t gbl_sync_ppu_phase;
+
 /* ---- diagnostics -------------------------------------------------------- */
 extern uint8_t gbl_interp_only;     /* ignore compiled code (reference mode) */
 extern uint32_t gbl_frame;
