+    if (h0 < halt_last_cyc && halt_last_cyc - h0 > 0x80000000u) gbl_sync_halt_snd += 128;
+    halt_last_cyc = h0;
+}
+static uint32_t halt_grid_phase(void) {
+    uint32_t v = (uint32_t)(gbl_sync_halt_snd - 1);
