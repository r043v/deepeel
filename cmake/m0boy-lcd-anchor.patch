+/* LCD off: gambatte's frame clock at the disable write (memory.cpp FF40):
+ * the next blit is cc + 4 lines, then every frame length.  off_start keeps
+ * the "last frame start <= now" invariant: first off frame at write+4*LINE,
+ * then +FRAME_CYCLES each (the Crystal TAS desync: a whole-frame anchor
+ * shifts the frame numbering across every LCD-off period). */
+static uint32_t lcd_off_anchor(uint32_t now, uint8_t off_ly) {
+    (void)off_ly;
+    return now - (FRAME_CYCLES - 4u * LINE_CYCLES);
+}
