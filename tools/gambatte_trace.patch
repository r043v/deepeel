+	// deepeel trace extension: compact ROM index (bank * 0x4000 + (addr & 0x3FFF)) of a CPU address, -1 if not ROM
+	// deepeel trace extension: side-effect free byte at a (ROM, WRAM, HRAM); 0 elsewhere
+	unsigned dpPeek(unsigned a) const {
+		if (a < 0x8000) return cart_.rmem(a >> 12)[a];
+		if (a >= 0xC000 && a < 0xE000) return cart_.wramdata(a >> 12 & 1)[a & 0xFFF];
+		if (a >= 0xFF80 && a < 0xFFFF) return ioamhram_[a - 0xFE00];
+		return 0;
+	}
+	long dpRomIndex(unsigned a) const { return a >= 0x8000 ? -1 : (long)(cart_.romdata((a >> 14) & 1) + a - cart_.dpRomBase()); }
 
