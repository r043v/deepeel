+// ---- deepeel trace extension: branch observation / forcing (see tools/gambatte_trace.patch) ----
+int dp_force_cond = -1;                 // -1 natural, 0/1 force the next conditional
+void (*dp_branch_cb)(unsigned pc) = 0;  // a conditional is decided at pc (opcode address)
+unsigned dp_op_pc = 0;
+static inline bool dp_cond(bool natural) {
+	if (dp_branch_cb) dp_branch_cb(dp_op_pc);
+	if (dp_force_cond >= 0) { bool f = dp_force_cond != 0; dp_force_cond = -1; return f; }
+	return natural;
+}
+#define DP_COND(e) dp_cond((e) != 0)
