 	cpu_hook = hook;
 }
 
-#endif /* HOOK_CPU */
\ No newline at end of file
+#endif /* HOOK_CPU */
+
+/* ---- deepeel trace extension (level B, DP_LR_ENV_TRACE) -------------------------------- */
+#include <stdint.h>
+#include "shared.h"
+#include "libretro.h"
+
+#define DP_LR_ENV_TRACE 0x7DEE0001u
+typedef struct {
+  void *user;
+  void (*exec)(void *, uint32_t);
+  void (*read)(void *, uint32_t, uint8_t);
+  void (*write)(void *, uint32_t, uint8_t);
+  void (*dma)(void *, uint32_t, uint32_t, uint32_t);
+  void (*bank)(void *, uint32_t, uint32_t);
+  void (*branch)(void *, uint32_t);
+} dp_obs_t;
+typedef struct {
+  uint32_t version;
+  int (*step)(void);
+  void (*set_observers)(const dp_obs_t *);
+  uint32_t (*pc)(void);
+  int (*force_branch)(int);
+  int64_t (*rom_index)(uint32_t);
+} dp_trace_t;
+
+extern int dp_m68k_step(void);
+int dp_force_cond = -1;
+void (*dp_branch_cb)(void);
+static dp_obs_t obs;
+static uint32_t cur_pc;
+
+static void dp_branch(void) { if (obs.branch) obs.branch(obs.user, cur_pc); }
+static void dp_hook(hook_type_t type, int width, unsigned int address, unsigned int value)
+{
+  int i;
+  if (type == HOOK_M68K_E) { cur_pc = address; if (obs.exec) obs.exec(obs.user, address); }
+  else if (type == HOOK_M68K_R && obs.read)
+    for (i = 0; i < width; i++) obs.read(obs.user, address + i, (uint8_t)(value >> (8 * (width - 1 - i))));
+  else if (type == HOOK_M68K_W && obs.write)
+    for (i = 0; i < width; i++) obs.write(obs.user, address + i, (uint8_t)(value >> (8 * (width - 1 - i))));
+}
+static int t_step(void) { return dp_m68k_step(); }
+static void t_set(const dp_obs_t *o)
+{
+  if (o) { obs = *o; set_cpu_hook(dp_hook); dp_branch_cb = o->branch ? dp_branch : NULL; }
+  else { memset(&obs, 0, sizeof obs); set_cpu_hook(NULL); dp_branch_cb = NULL; }
+}
+static uint32_t t_pc(void) { return cur_pc; }
+static int t_force(int taken) { dp_force_cond = taken; return 1; }
+static int64_t t_rom_index(uint32_t a) { return a < cart.romsize ? (int64_t)a : -1; }
+
+void dp_trace_register(int (*env)(unsigned, void *))
+{
+  dp_trace_t t = { 1, t_step, t_set, t_pc, t_force, t_rom_index };
+  env(DP_LR_ENV_TRACE, &t);
+}
