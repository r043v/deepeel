+/* deepeel trace extension: a conditional can be forced and observed (see tools/gpgx_trace.patch) */
+#ifdef HOOK_CPU
+extern int dp_force_cond;
+extern void (*dp_branch_cb)(void);
+static inline int dp_cond_fn(int v) {
+  if (dp_branch_cb) dp_branch_cb();
+  if (dp_force_cond >= 0) { v = dp_force_cond; dp_force_cond = -1; }
+  return v;
+}
+#define DP_COND(x) dp_cond_fn((x) != 0)
+#else
+#define DP_COND(x) (x)
+#endif
+#define RAW_COND_CS() (FLAG_C&0x100)
+#define RAW_COND_CC() (!RAW_COND_CS())
+#define RAW_COND_VS() (FLAG_V&0x80)
+#define RAW_COND_VC() (!RAW_COND_VS())
+#define RAW_COND_NE() FLAG_Z
+#define RAW_COND_EQ() (!RAW_COND_NE())
+#define RAW_COND_MI() (FLAG_N&0x80)
+#define RAW_COND_PL() (!RAW_COND_MI())
+#define RAW_COND_LT() ((FLAG_N^FLAG_V)&0x80)
+#define RAW_COND_GE() (!RAW_COND_LT())
+#define RAW_COND_HI() (RAW_COND_CC() && RAW_COND_NE())
+#define RAW_COND_LS() (RAW_COND_CS() || RAW_COND_EQ())
+#define RAW_COND_GT() (RAW_COND_GE() && RAW_COND_NE())
+#define RAW_COND_LE() (RAW_COND_LT() || RAW_COND_EQ())
+
+
+#define COND_CS() DP_COND(RAW_COND_CS())
+#define COND_CC() DP_COND(RAW_COND_CC())
+#define COND_VS() DP_COND(RAW_COND_VS())
+#define COND_VC() DP_COND(RAW_COND_VC())
+#define COND_NE() DP_COND(RAW_COND_NE())
+#define COND_EQ() DP_COND(RAW_COND_EQ())
+#define COND_MI() DP_COND(RAW_COND_MI())
+#define COND_PL() DP_COND(RAW_COND_PL())
+#define COND_LT() DP_COND(RAW_COND_LT())
+#define COND_GE() DP_COND(RAW_COND_GE())
+#define COND_HI() DP_COND(RAW_COND_HI())
+#define COND_LS() DP_COND(RAW_COND_LS())
+#define COND_GT() DP_COND(RAW_COND_GT())
+#define COND_LE() DP_COND(RAW_COND_LE())
 
 /* Reversed conditions */
 #define COND_NOT_CS() COND_CC()
